# Plaqad self-hosted FlexPrice dashboard
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache git

ARG FLEXPRICE_FRONT_SOURCE_REPOSITORY=https://github.com/BHM-Ailabs/flexprice-front.git
ARG FLEXPRICE_FRONT_SOURCE_REF=e607431f46228eb4def3bf49b8e0c8faa6d63700

# Railway exposes service variables to Docker builds as build arguments when
# they are declared here. The client ID is public; the confidential client
# secret remains API-runtime-only and must never be declared in this image.
ARG VITE_PLAQAD_AUTH_ENABLED=false
ARG VITE_PLAQAD_AUTH_URL=https://account-api.plaqad.com
ARG VITE_PLAQAD_CLIENT_ID

RUN git init . \
    && git remote add origin "$FLEXPRICE_FRONT_SOURCE_REPOSITORY" \
    && git fetch --depth 1 origin "$FLEXPRICE_FRONT_SOURCE_REF" \
    && git checkout --detach FETCH_HEAD

RUN npm ci
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
